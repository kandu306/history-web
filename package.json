{
  "name": "history-web",
  "version": "1.0.0",
  "description": "Website tĩnh phân tích các nhân vật lịch sử Việt Nam theo hệ thống **3 Gốc / 3 Độc**.",
  "scripts": {
    "build:css": "tailwindcss -i src/shared/tailwind-input.css -o src/shared/tailwind.css --minify",
    "build": "npm run build:css && eleventy",
    "serve": "npm run build:css && concurrently \"tailwindcss -i src/shared/tailwind-input.css -o src/shared/tailwind.css --watch\" \"eleventy --serve\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kandu306/history-web.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kandu306/history-web/issues"
  },
  "homepage": "https://github.com/kandu306/history-web#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.3",
    "tailwindcss": "^3.4.19"
  }
}

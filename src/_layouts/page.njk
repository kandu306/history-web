<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">

  <!-- Open Graph -->
  <meta property="og:type" content="{{ ogType or "article" }}">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:image" content="{{ ogImage or (site.url + "/shared/og-image.svg") }}">
  <meta property="og:url" content="{{ site.url }}{{ page.filePathStem }}.html">
  <meta name="twitter:card" content="summary_large_image">

  <!-- Favicon -->
  <link class="js-favicon" rel="icon" type="image/svg+xml" href="{{ rel }}shared/favicon.svg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">

  <!-- Shared Assets -->
  <link rel="stylesheet" href="{{ rel }}shared/tailwind.css">
  <link rel="stylesheet" href="{{ rel }}shared/styles.css">
  <script src="{{ rel }}shared/scripts.js" defer></script>
</head>

<body class="{{ bodyClass or "font-sans antialiased text-[#1c1917]" }}">

  <!-- Reading Progress -->
  <div id="progress-bar"></div>

{% if not customNav %}{% include "nav.njk" %}{% endif %}
{{ content | safe }}
</body>
</html>
